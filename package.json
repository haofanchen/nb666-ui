{
  "name": "aurora-ui",
  "version": "1.0.0",
  "description": "优雅、现代的 React 组件库，提供一致的设计语言与丰富的组件。",
  "type": "module",
  "main": "./dist/aurora-ui.cjs",
  "module": "./dist/aurora-ui.js",
  "types": "./dist/components/ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/aurora-ui.js",
      "require": "./dist/aurora-ui.cjs"
    },
    "./styles.css": "./dist/aurora-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "preview": "vite preview --outDir docs-dist",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "aurora-ui"
  ],
  "license": "MIT",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "tailwind-merge": "^3.0.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
